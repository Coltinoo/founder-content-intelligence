# ─────────────────────────────────────────────────────────────────────────────
# Founder Content Intelligence Engine — environment configuration
# Copy to `.env` and fill in what you have. The app runs with NONE of these set;
# every connector degrades to a clearly-labelled "not configured" state.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Leave FCIE_DATABASE_URL unset to use local SQLite at ./data/fcie.db
# Supabase Postgres example (session pooler):
#   postgresql+psycopg2://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
FCIE_DATABASE_URL=

# ── OpenAI (AI extraction, clustering assist, briefs, drafts, web search) ────
# Without this the app falls back to the deterministic heuristic analyser.
OPENAI_API_KEY=
FCIE_OPENAI_MODEL=gpt-4o-mini
# Set to 1 to use the OpenAI Responses API `web_search` tool for query discovery
FCIE_OPENAI_WEB_SEARCH=0

# ── Web search providers (pick ONE; checked in this order) ──────────────────
# 1. Tavily      https://tavily.com
TAVILY_API_KEY=
# 2. Brave Search https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# 3. Bing Web Search (Azure)
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# 4. Google Programmable Search
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ── YouTube ─────────────────────────────────────────────────────────────────
# Without a key the connector falls back to public per-channel RSS feeds
# (https://www.youtube.com/feeds/videos.xml?channel_id=...), which need no auth.
YOUTUBE_API_KEY=

# ── Crawler etiquette ───────────────────────────────────────────────────────
FCIE_USER_AGENT=FounderContentIntelligenceEngine/0.1 (independent candidate project; +https://github.com/)
FCIE_CRAWL_DELAY_SECONDS=2.0
FCIE_REQUEST_TIMEOUT=25
FCIE_RESPECT_ROBOTS=1
FCIE_MAX_SOURCES_PER_RUN=60

# Reddit Data API — the highest-yield social channel for this market.
# Register a "script" app at https://www.reddit.com/prefs/apps (free, ~2 min).
# These are application credentials, not an account login. Reddit's robots.txt
# is Disallow:/ so the public RSS endpoints are not an option; this is the
# sanctioned route. Without them the Reddit channel reports itself unconfigured
# and everything else runs unchanged.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
